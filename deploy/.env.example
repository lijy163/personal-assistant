POSTGRES_DB=personal_assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=please_change_this_password
POSTGRES_PORT=5432
SPRING_PROFILES_ACTIVE=prod

# 生产环境必须改成至少 32 字节的随机字符串
JWT_SECRET=please_change_this_to_a_long_random_secret_at_least_32_bytes
JWT_EXPIRATION_MINUTES=720
T1QQ_API_KEY=

# 备份保留天数和磁盘使用率告警阈值
BACKUP_RETENTION_DAYS=14
STORAGE_WARNING_PERCENT=85

# 云服务器 Codex Agent
PA_AGENT_TOKEN=
CODEX_API_KEY=
OPENAI_BASE_URL=https://www.xshoow.cloud/v1
CODEX_DEBIAN_MIRROR=http://mirrors.cloud.tencent.com
CODEX_NPM_REGISTRY=https://registry.npmmirror.com

# 云主机宿主机上的 Git 拉取代理；留空则直连
HOST_PROXY_URL=http://127.0.0.1:7890
# Codex Agent 容器及其 Codex CLI 使用的代理；通过共享 Docker 网络访问 ShellCrash
CONTAINER_PROXY_URL=http://shellcrash:7890
SHELLCRASH_NETWORK_NAME=shellcrash-proxy
NO_PROXY=localhost,127.0.0.1,backend,postgres,nginx

# 企业微信自建应用
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_DEFAULT_CODEX_AGENT_ID=
WECOM_DEFAULT_PROJECT_KEY=personal-assistant
WECOM_ALLOWED_USERS=

# 无需登录的公开问答（使用独立空白目录，不暴露生产项目）
PUBLIC_CODEX_ENABLED=false
PA_PUBLIC_AGENT_TOKEN=
PUBLIC_CODEX_AGENT_ID=
PUBLIC_CODEX_PROJECT_KEY=public-qa
PUBLIC_CODEX_MINIMUM_INTERVAL_SECONDS=10
PUBLIC_CODEX_MAX_ACTIVE_TASKS_PER_SESSION=2
PUBLIC_CODEX_MAX_ACTIVE_TASKS=20
