---
import "../styles/global.scss";
const SITE_THEME={light:"garden",dark:"dracula"};
const { title = "Rain7", description = "记录技术、生活与持续成长", hero = true } = Astro.props;
---
<!doctype html><html lang="zh-CN" data-theme={SITE_THEME.light}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><link rel="icon" href="/rain7/favicon.ico"/><title>{title === "Rain7" ? title : `${title} · Rain7`}</title><script is:inline define:vars={{SITE_THEME}}>(function(){const saved=localStorage.getItem('rain7-astro-theme');document.documentElement.dataset.theme=saved||SITE_THEME.light;})();</script></head><body class="min-h-screen bg-[var(--banner-wave-bg)] text-base-content"><header class="rain-nav"><a class="rain-brand" href="/rain7/"><img src="/rain7/rain7-avatar.svg" alt="Rain7"/><b>Rain7</b></a><nav><a href="/rain7/">首页</a><a href="/blog">工作记录</a><a href="/blog/manage">内容管理</a><button id="theme-toggle" aria-label="切换主题">◐</button></nav></header>{hero&&<section class="rain-banner"><div class="banner-glow"></div><div class="banner-text"><span>WELCOME TO</span><h1>Rain7</h1><p>把日子写成故事，把思考留给时间</p></div><div class="waves"><svg viewBox="0 24 150 28" preserveAspectRatio="none"><defs><path id="wave" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18v44h-352z"/></defs><g><use href="#wave" x="48" y="0" opacity=".25"/><use href="#wave" x="48" y="4" opacity=".5"/><use href="#wave" x="48" y="7"/></g></svg></div></section>}<div class:list={["rain-page",!hero&&"no-hero"]}><slot/></div><footer class="rain-footer"><div><img src="/rain7/rain7-avatar.svg" alt=""/><span><b>Rain7</b><small>记录技术、生活与持续成长</small></span></div><p>基于 <a href="https://github.com/kobaridev/RyuChan" target="_blank" rel="noreferrer">RyuChan</a> 模板改造 · MIT License · {new Date().getFullYear()}</p></footer><script is:inline>document.getElementById('theme-toggle')?.addEventListener('click',()=>{const html=document.documentElement;const next=html.dataset.theme==='dracula'?'garden':'dracula';html.dataset.theme=next;localStorage.setItem('rain7-astro-theme',next);});</script></body></html>
<style is:global>
.rain-nav{position:fixed;top:18px;left:50%;z-index:50;display:flex;width:min(1180px,calc(100% - 32px));height:68px;align-items:center;justify-content:space-between;padding:0 18px;background:oklch(var(--b1)/.78);border:1px solid oklch(var(--bc)/.12);border-radius:999px;box-shadow:0 15px 42px rgb(25 20 60/.22);backdrop-filter:blur(18px);transform:translateX(-50%)}.rain-brand{display:flex;gap:10px;align-items:center;font-size:20px}.rain-brand img{width:43px;height:43px;border-radius:50%}.rain-nav nav{display:flex;gap:5px;align-items:center}.rain-nav nav a,.rain-nav button{padding:9px 13px;border-radius:13px;font-size:14px;font-weight:700}.rain-nav nav a:hover,.rain-nav button:hover{color:oklch(var(--p));background:oklch(var(--p)/.1)}.rain-nav button{border:0;background:transparent;cursor:pointer}.rain-banner{position:relative;height:66vh;min-height:470px;overflow:hidden;color:#fff;background:radial-gradient(circle at 72% 28%,rgb(255 255 255/.22),transparent 8%),linear-gradient(125deg,#342c61,#7166aa 48%,#aaa1ce)}.rain-banner:before{position:absolute;inset:0;content:"";background:repeating-linear-gradient(120deg,transparent 0 35px,rgb(255 255 255/.035) 36px 37px)}.banner-glow{position:absolute;top:13%;right:11%;width:320px;height:320px;border:1px solid rgb(255 255 255/.18);border-radius:50%;box-shadow:0 0 100px rgb(255 255 255/.08) inset}.banner-text{position:absolute;top:48%;left:50%;z-index:2;text-align:center;transform:translate(-50%,-50%)}.banner-text span{font-size:11px;letter-spacing:.35em;opacity:.78}.banner-text h1{margin:5px 0;font-family:"Songti SC",serif;font-size:clamp(62px,9vw,112px);line-height:1.15;text-shadow:0 10px 35px rgb(24 18 62/.32)}.banner-text p{font-size:clamp(15px,2vw,25px);letter-spacing:.14em}.waves,.waves svg{position:absolute;right:0;bottom:-1px;left:0;width:100%;height:110px}.waves use{fill:var(--banner-wave-bg);animation:rain-wave 22s linear infinite}.waves use:nth-child(2){animation-duration:15s}.waves use:nth-child(3){animation-duration:10s}@keyframes rain-wave{to{transform:translateX(85px)}}.rain-page{width:min(1180px,calc(100% - 32px));margin:30px auto}.rain-page.no-hero{padding-top:110px}.rain-footer{display:flex;width:min(1180px,calc(100% - 32px));align-items:center;justify-content:space-between;padding:32px 0 44px;margin:60px auto 0;border-top:1px solid oklch(var(--bc)/.12);color:oklch(var(--bc)/.62);font-size:12px}.rain-footer>div{display:flex;gap:10px;align-items:center}.rain-footer img{width:38px;height:38px;border-radius:12px}.rain-footer span{display:flex;flex-direction:column}.rain-footer a{font-weight:800;color:oklch(var(--p))}@media(max-width:650px){.rain-nav{top:9px;width:calc(100% - 18px);height:58px;padding:0 8px}.rain-brand b{display:none}.rain-brand img{width:40px;height:40px}.rain-nav nav a{padding:8px 7px;font-size:12px}.rain-banner{height:53vh;min-height:400px}.banner-text{width:90%}.banner-text p{font-size:14px;letter-spacing:.06em}.rain-page{width:calc(100% - 20px);margin-top:18px}.rain-footer{align-items:flex-start;flex-direction:column;gap:20px}}
</style>