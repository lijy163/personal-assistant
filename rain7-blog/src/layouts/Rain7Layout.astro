---
import "../styles/global.scss";
import Rain7MusicPlayer from "../components/Rain7MusicPlayer";
const { title = "Rain7", description = "记录技术、生活与持续成长", hero = true } = Astro.props;
---
<!doctype html><html lang="zh-CN" data-theme="rain7"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><link rel="icon" href="/rain7/favicon.ico"/><title>{title === "Rain7" ? title : `${title} · Rain7`}</title><script is:inline>(function(){if(localStorage.getItem('rain7-astro-theme')==='dark')document.documentElement.classList.add('dark');})();</script></head><body>
<header class="ryu-navbar"><a class="ryu-logo" href="/rain7/"><img src="/rain7/rain7-avatar.svg" alt="Rain7"/><b>Rain7</b></a><nav><a href="/blog/manage"><span>✎</span> 写作</a><a href="/rain7/"><span>◉</span> 首页</a><a href="/rain7/#rain-categories"><span>▣</span> 分类</a><a href="/rain7/#rain-tags"><span>◇</span> 标签</a><a href="#rain7-music-player"><span>♪</span> 音乐</a><a href="/blog"><span>▤</span> 工作记录</a></nav><div class="ryu-tools"><button id="theme-toggle" aria-label="切换主题">☀</button></div></header>
{hero&&<section class="ryu-banner"><div class="ryu-banner-bg"></div><div class="ryu-banner-mask"></div><div class="ryu-hero-copy"><h1>Rain7's Blog</h1><p><span>🌸</span> 欲买桂花同载酒，终不似，少年游！</p></div><div class="ryu-waves"><svg viewBox="0 24 150 28" preserveAspectRatio="none"><defs><path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18v44h-352z"/></defs><g><use href="#gentle-wave" x="48" y="0"/><use href="#gentle-wave" x="48" y="4"/><use href="#gentle-wave" x="48" y="7"/></g></svg></div></section>}
<div class:list={["rain-page",!hero&&"no-hero"]}><slot/></div><Rain7MusicPlayer client:load/><footer class="rain-footer"><div><img src="/rain7/profile.png" alt=""/><span><b>Rain7</b><small>记录技术、生活与持续成长</small></span></div><p>基于 <a href="https://github.com/kobaridev/RyuChan" target="_blank" rel="noreferrer">RyuChan</a> 风格改造 · MIT License · {new Date().getFullYear()}</p></footer>
<script is:inline>document.getElementById('theme-toggle')?.addEventListener('click',()=>{document.documentElement.classList.toggle('dark');localStorage.setItem('rain7-astro-theme',document.documentElement.classList.contains('dark')?'dark':'light');});</script></body></html>